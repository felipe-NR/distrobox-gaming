# Let a container read 8BitDo hidraw nodes.
#
# Some hosts create the 8BitDo hidraw node as root:root 0600 with no uaccess
# ACL (an ACL would not cross into a container anyway). The gaming box no
# longer gets hidraw nodes (migrate-gaming-box.sh passes /dev/input only), but
# the Lichii sandbox passes the reference pad's hidraw node with its group, so
# give the node to the `input` group.
#
# 8BitDo vendor ID 2dc8 (Ultimate 2 and its 2.4 GHz dongle). Install on the
# HOST, then reload and replug the pad:
#   sudo install -m0644 config/host-udev-rules/70-8bitdo-hidraw.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=hidraw
# See docs/game-runtime-security.md.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", GROUP="input", MODE="0660"
